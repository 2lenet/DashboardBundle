{# Placeholders of a set of static widgets, filled by ajax (see static_dashboard.html.twig) #}
<div class="static-dashboard row">
    {% for index, widget in widgets %}
        <div class="{{ widget.staticCssClass }} mb-4 static-widget-container" data-widget-index="{{ index }}">
            <div class="card border-dark h-100">
                <div class="card-header text-dark">
                    <h5 class="card-title mb-0">{{ widget.title | default(widget.name|trans) }}</h5>
                </div>
                <div class="card-body text-center">
                    <i class="fa fa-5x fa-circle-o-notch fa-spin"></i>
                </div>
            </div>
        </div>
    {% endfor %}
</div>
