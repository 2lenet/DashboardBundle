{% extends "base.html.twig" %}

{% block page_title %}{{ 'dashboard'|trans(domain='messages') }}{% endblock %}

{% block head_javascript %}
    {{ parent() }}
    <script src="{{ asset('bundles/lledashboard/dashboard/staticapp.js') }}"></script>
{% endblock %}

{% block head_stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/lledashboard/dashboard/app.css') }}"/>
    <style>
        .static-dashboard .widget-close,
        .static-dashboard .widget-config,
        .static-dashboard .show-hover,
        .static-dashboard .lle-dashboard-input-title { pointer-events: none; }
        .static-dashboard .widget-close,
        .static-dashboard .widget-config,
        .static-dashboard .show-hover { display: none !important; }
        .static-dashboard .lle-dashboard-input-title { border: none; background: transparent; }
    </style>
{% endblock %}

{% block main %}
    {{ parent() }}
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-sm mb-2 mb-sm-0">
                <h2 class="page-header-title text-dark">
                    {{ 'dashboard' | trans }}
                </h2>
            </div>
        </div>
    </div>

    {# both variables are defaulted: the template can be rendered by an application's own controller,
       or by the controller of an older version of the bundle, which only provided "widgets" #}
    {% set dashboardTabs = tabs|default([]) %}
    {% set dashboardWidgets = widgets|default([]) %}

    {% if dashboardTabs is not empty %}
        <ul class="nav nav-tabs static-dashboard-tabs mb-4" role="tablist">
            {% for entry in dashboardTabs %}
                <li class="nav-item" role="presentation">
                    <button
                        class="nav-link{{ loop.first ? ' active' }}{{ entry.tab.cssClass ? ' ' ~ entry.tab.cssClass }}"
                        id="static-tab-{{ entry.tab.key }}"
                        type="button"
                        role="tab"
                        aria-controls="static-tab-pane-{{ entry.tab.key }}"
                        aria-selected="{{ loop.first ? 'true' : 'false' }}"
                        data-static-tab="{{ entry.tab.key }}"
                    >
                        {% if entry.tab.icon %}<i class="{{ entry.tab.icon }} me-2"></i>{% endif %}
                        {{ entry.tab.label | trans }}
                    </button>
                </li>
            {% endfor %}
        </ul>

        <div class="tab-content">
            {% for entry in dashboardTabs %}
                <div
                    class="tab-pane{{ loop.first ? ' active' }}"
                    id="static-tab-pane-{{ entry.tab.key }}"
                    role="tabpanel"
                    aria-labelledby="static-tab-{{ entry.tab.key }}"
                    data-static-tab-pane="{{ entry.tab.key }}"
                >
                    {{ include('@LleDashboard/dashboard/_static_widgets.html.twig', { widgets: entry.widgets }) }}
                </div>
            {% endfor %}
        </div>
    {% else %}
        {{ include('@LleDashboard/dashboard/_static_widgets.html.twig', { widgets: dashboardWidgets }) }}
    {% endif %}

{% endblock %}
